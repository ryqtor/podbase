# Environment Configuration for Lenny Growth Assistant
# Copy this file to .env and fill in your values

# ============================================
# Database (PostgreSQL + pgvector)
# ============================================
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password
POSTGRES_DB=lenny_growth
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# OpenAI
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model defaults
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Ollama (optional — app works without it)
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================================
# LLM Provider Config
# ============================================
# Default provider: "openai" or "ollama"
DEFAULT_LLM_PROVIDER=openai
# Enable fallback to other provider if primary fails
LLM_FALLBACK_ENABLED=true

# ============================================
# RAG Configuration
# ============================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MIN_SIMILARITY_THRESHOLD=0.3

# ============================================
# Application
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=3001
LOG_LEVEL=INFO
ENVIRONMENT=development

# ============================================
# Frontend (passed at build time)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
